{
  "name": "@vroomchart/react",
  "version": "0.1.5",
  "description": "Skia-quality candlestick chart for the web (React DOM).",
  "license": "MIT",
  "author": "Darion Welch",
  "homepage": "https://github.com/darionwelch/vroom#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darionwelch/vroom.git",
    "directory": "packages/react"
  },
  "keywords": [
    "chart",
    "candlestick",
    "react",
    "skia",
    "wasm",
    "finance",
    "trading",
    "charting"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsup",
    "prepublishOnly": "tsup"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@vroomchart/core-wasm": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "@types/react-dom": "~19.1.0",
    "@vroomchart/types": "workspace:*",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.2",
    "vitest": "^2.1.9"
  }
}
