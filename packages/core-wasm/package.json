{
  "name": "@vroomchart/core-wasm",
  "version": "0.14.0",
  "description": "Framework-agnostic web core for the vroom chart — Skia-WASM renderer with a Canvas2D fallback.",
  "license": "MIT",
  "author": "Darion Welch",
  "homepage": "https://github.com/keepitreal/vroom#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keepitreal/vroom.git",
    "directory": "packages/core-wasm"
  },
  "keywords": [
    "chart",
    "candlestick",
    "skia",
    "wasm",
    "webassembly",
    "canvas",
    "finance",
    "trading",
    "ohlcv",
    "technical-analysis",
    "indicators",
    "stock-chart",
    "typescript",
    "renderer"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "assets",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "build:wasm": "../core/scripts/build-wasm.sh",
    "prepublishOnly": "tsup"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@vroomchart/types": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "~5.9.2"
  }
}
