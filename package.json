{
  "name": "vroom",
  "private": true,
  "version": "0.0.0",
  "description": "Mobile-first Skia candlestick chart library — monorepo root",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "start": "pnpm --filter test-bench start",
    "rebuild:ios": "pnpm --filter test-bench rebuild:ios",
    "test": "pnpm --filter react-native-vroom-chart test",
    "test:core": "cmake -S packages/core -B packages/core/build -DVROOM_BUILD_TESTS=ON && cmake --build packages/core/build --target vroom_tests && ctest --test-dir packages/core/build --output-on-failure",
    "docs": "pnpm --filter vroom-docs start",
    "docs:build": "pnpm --filter vroom-docs build",
    "build:packages": "pnpm --filter @vroomchart/core-wasm --filter @vroomchart/react --filter react-native-vroom-chart run build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build:packages && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.11"
  }
}
